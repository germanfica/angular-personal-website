{
  "name": "personal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run generate-env && npm run generate-sitemap && ng serve",
    "build": "npm run generate-env && npm run generate-sitemap && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:personal": "node dist/personal/server/server.mjs",
    "generate-env": "node generate-env.js",
    "generate-sitemap": "node generate-sitemap.js",
    "build-and-sitemap": "ng build && npm run generate-sitemap"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.2",
    "express": "^5.1.0",
    "ng-recaptcha-2": "22.0.1",
    "ngx-bootstrap-icons": "^1.9.3",
    "particles.js": "^2.0.0",
    "rxjs": "~7.8.0",
    "sitemap": "^9.0.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
